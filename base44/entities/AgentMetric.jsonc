{
  "name": "AgentMetric",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "title": "Agent ID"
    },
    "agent_name": {
      "type": "string",
      "title": "Agent Name"
    },
    "success_rate": {
      "type": "number",
      "title": "Success Rate",
      "default": 0
    },
    "avg_response_ms": {
      "type": "number",
      "title": "Avg Response (ms)",
      "default": 0
    },
    "cost_per_task": {
      "type": "number",
      "title": "Cost Per Task",
      "default": 0
    },
    "tasks_completed": {
      "type": "number",
      "title": "Tasks Completed",
      "default": 0
    },
    "timestamp": {
      "type": "string",
      "title": "Timestamp"
    }
  },
  "required": [
    "agent_id"
  ]
}